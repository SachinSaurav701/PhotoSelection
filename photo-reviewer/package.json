{
  "name": "photo-reviewer",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop app for photographers to create review packages and apply client selections.",
  "main": "electron/main.js",
  "author": "",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "start": "electron .",
    "build:renderer": "vite build",
    "build": "vite build && electron-builder -w",
    "package": "electron-builder -w --dir",
    "lint": "echo 'No linter configured'"
  },
  "dependencies": {
    "fs-extra": "^11.2.0",
    "jimp": "^0.22.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^30.0.9",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.example.photoreviewer",
    "productName": "Photo Reviewer",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "viewer/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    }
  }
}